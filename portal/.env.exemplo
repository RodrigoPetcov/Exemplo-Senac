# Copie para .env e preencha. O arquivo .env não vai para o GitHub.
# Na hospedagem (ex.: Hostinger), cadastre estas variáveis no painel em vez de usar o .env.
SENHA_EDICAO=troque-esta-senha
# Porta só para rodar no computador. Na hospedagem a porta vem da variável PORT, automaticamente.
PORTA=3000
# Caminho do banco SQLite (opcional; padrão: servidor/cartas.db)
# BANCO_ARQUIVO=/home/usuario/dados/cartas.db
# Só se o site estiver hospedado em outro domínio que o servidor:
# CORS_ORIGEM=https://www.seusite.com.br
